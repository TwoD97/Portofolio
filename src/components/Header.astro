---
import { Icon } from 'astro-icon/components';
import { nav, site } from '../data/content';
import LangToggle from './LangToggle.astro';
---

<header class="sticky top-0 z-40 border-b-2 border-ink bg-paper/95 backdrop-blur">
  <div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-5">
    <a href="#top" class="flex items-center gap-2.5">
      <span
        class="grid h-9 w-9 place-items-center border-2 border-ink bg-accent font-display text-sm font-extrabold text-ink shadow-[3px_3px_0_0_#0a0a0a]"
      >
        {site.monogram}
      </span>
      <span class="hidden font-display text-base font-bold uppercase tracking-tight text-ink sm:inline">
        {site.shortName}
      </span>
    </a>

    <nav aria-label="Hauptnavigation" class="hidden items-center gap-6 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="font-mono text-xs font-medium uppercase tracking-wide text-ink decoration-accent decoration-2 underline-offset-4 transition-colors hover:underline"
          >
            <span lang="de" data-lang-de>{item.label.de}</span>
            <span lang="en" data-lang-en>{item.label.en}</span>
          </a>
        ))
      }
      <LangToggle />
    </nav>

    <div class="flex items-center gap-3 md:hidden">
      <LangToggle />
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid h-10 w-10 place-items-center border-2 border-ink bg-card text-ink shadow-[3px_3px_0_0_#0a0a0a] transition active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
      >
        <span class="sr-only">
          <span lang="de" data-lang-de>Menü öffnen oder schließen</span><span lang="en" data-lang-en>Open or close menu</span>
        </span>
        <Icon name="lucide:menu" data-icon-menu class="h-5 w-5" aria-hidden="true" />
        <Icon name="lucide:x" data-icon-close class="h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    data-mobile-menu
    data-open="false"
    inert
    class="overflow-hidden border-t-2 border-ink bg-paper transition-[max-height] duration-300 ease-out data-[open=false]:max-h-0 data-[open=true]:max-h-96 md:hidden"
  >
    <nav aria-label="Mobile Navigation" class="mx-auto flex max-w-5xl flex-col px-5 py-2">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="border-b border-ink/15 px-2 py-3 font-mono text-sm font-medium uppercase tracking-wide text-ink transition-colors last:border-0 hover:bg-accent"
          >
            <span lang="de" data-lang-de>{item.label.de}</span>
            <span lang="en" data-lang-en>{item.label.en}</span>
          </a>
        ))
      }
    </nav>
  </div>
</header>
