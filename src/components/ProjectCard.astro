---
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/content';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const featured = project.featured ?? false;
---

<article
  class:list={[
    'btl-card flex flex-col p-5 sm:p-6',
    featured && 'sm:col-span-2',
  ]}
>
  <div class="mb-4 flex items-center justify-between gap-3">
    <span
      class:list={[
        'grid h-11 w-11 place-items-center border-2 border-ink text-ink',
        featured ? 'bg-accent' : 'bg-accent-soft',
      ]}
    >
      <Icon name={project.icon} class="h-5 w-5" aria-hidden="true" />
    </span>
    <span class="border-2 border-ink px-2.5 py-0.5 font-mono text-[11px] font-bold uppercase text-ink">
      <span lang="de" data-lang-de>{project.context.de}</span><span lang="en" data-lang-en>{project.context.en}</span>
    </span>
  </div>

  <h3 class="font-display text-xl font-extrabold uppercase tracking-tight text-ink sm:text-2xl">
    <span lang="de" data-lang-de>{project.title.de}</span><span lang="en" data-lang-en>{project.title.en}</span>
  </h3>
  <p class="mt-2 text-sm font-semibold text-ink">
    <span lang="de" data-lang-de>{project.tagline.de}</span><span lang="en" data-lang-en>{project.tagline.en}</span>
  </p>
  <p class="mt-3 text-sm leading-relaxed text-muted sm:text-[15px]">
    <span lang="de" data-lang-de>{project.description.de}</span><span lang="en" data-lang-en>{project.description.en}</span>
  </p>

  <ul class="mt-5 flex flex-wrap gap-2">
    {
      project.tech.map((tag) => (
        <li class="border border-ink bg-paper-2 px-2 py-0.5 font-mono text-[11px] font-medium uppercase text-ink">
          {tag}
        </li>
      ))
    }
  </ul>

  {
    project.link && (
      <a
        href={project.link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex w-fit items-center gap-2 border-2 border-ink bg-accent px-3.5 py-2 font-mono text-xs font-bold uppercase text-ink shadow-[3px_3px_0_0_#0a0a0a] transition hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[5px_5px_0_0_#0a0a0a]"
      >
        <Icon name="simple-icons:github" class="h-4 w-4" aria-hidden="true" />
        <span lang="de" data-lang-de>{project.link.label.de}</span><span lang="en" data-lang-en>{project.link.label.en}</span>
        <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    )
  }
</article>
